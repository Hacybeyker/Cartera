<?xml version="1.0" encoding="utf-8"?>
<!-- El deviceToken cifrado no sirve en otro dispositivo (su clave no sale del Keystore): no se respalda ni se transfiere. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="cartera_biometric.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="cartera_biometric.xml" />
  </device-transfer>
</data-extraction-rules>
